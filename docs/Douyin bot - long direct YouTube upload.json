{
  "name": "Douyin bot - long direct YouTube upload",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [
        -1056,
        48
      ],
      "id": "3b014ce2-7ce7-46b2-811b-2fd4dd7796e6",
      "name": "Telegram - Nhận tin nhắn",
      "webhookId": "5ff8060a-485c-43da-84de-8db8b85eeb7b",
      "credentials": {
        "telegramApi": {
          "id": "zb856dYdLEif3rJO",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst message = $input.first().json.message;\nconst rawText = message?.text || message?.caption || '';\nconst chat_id = message?.chat?.id;\n\nfunction validateDouyinUrl(url) {\n  const cleaned = url.replace(/^!+/, '').replace(/[.,;!?，。；！？)\\]}]+$/g, '');\n  const parsed = cleaned.match(/^https?:\\/\\/([^/:?#]+)(\\/[^?#]*)?(?:[?#].*)?$/i);\n  if (!parsed) throw new Error('URL không đúng định dạng: ' + url);\n  const hostname = parsed[1].toLowerCase().replace(/^www\\./, '');\n  const pathname = parsed[2] || '/';\n  const validHost =\n    hostname === 'douyin.com' || hostname.endsWith('.douyin.com') ||\n    hostname === 'iesdouyin.com' || hostname.endsWith('.iesdouyin.com');\n  if (!validHost) throw new Error('Link không thuộc Douyin: ' + url);\n  const validPath =\n    (hostname === 'v.douyin.com' && /^\\/[A-Za-z0-9_-]+\\/?$/.test(pathname)) ||\n    /^\\/video\\/\\d+\\/?$/.test(pathname) ||\n    /^\\/share\\/video\\/\\d+\\/?$/.test(pathname) ||\n    /^\\/note\\/\\d+\\/?$/.test(pathname);\n  if (!validPath) throw new Error('Link Douyin không đúng định dạng video: ' + url);\n  return cleaned;\n}\n\nfunction makeId() {\n  return `telegram-${chat_id}-${message.message_id}-${Date.now()}`;\n}\n\nfunction extractBatchId(t) {\n  const m = (t || '').match(/telegram-\\d+-\\d+-\\d+/);\n  return m ? m[0] : '';\n}\n\nfunction findBatchId() {\n  const replyText = message?.reply_to_message?.text || message?.reply_to_message?.caption || '';\n  const sd = $getWorkflowStaticData('global');\n  return extractBatchId(replyText) || extractBatchId(rawText) || (sd['pending_' + chat_id] || '');\n}\n\ntry {\n  const trimmed = rawText.trim();\n  const lower = trimmed.toLowerCase();\n\n  let command = '';\n  let rest = trimmed;\n  const cmdMatch = trimmed.match(/^\\/([a-zA-Z0-9_]+)(?:@\\w+)?\\s*([\\s\\S]*)$/);\n  if (cmdMatch) { command = cmdMatch[1].toLowerCase(); rest = cmdMatch[2] || ''; }\n\n  if (command === 'help') {\n    const text = [\n      '🤖 <b>Bot tạo video từ Douyin</b>',\n      '',\n      '<b>/short</b> &lt;link&gt; — Tạo 1 video <b>Short</b> từ 1 link Douyin',\n      '<b>/long</b> &lt;link1&gt; [link2 ...] — Tạo video <b>dài</b> (duyệt quảng cáo trước khi đăng)',\n      '<b>/long --refresh</b> &lt;link...&gt; — Bỏ cache, chạy lại toàn bộ',\n      '',\n      '🕵️ <b>Duyệt quảng cáo (video long):</b>',\n      '• Bot sẽ gửi các mốc nghi quảng cáo sau khi dựng xong.',\n      '• Trả lời (reply) tin đó: <code>cắt đoạn 01:29:52 -&gt; 01:30:10</code> (nhiều đoạn mỗi dòng)',\n      '• Ưng ý thì reply: <code>đăng ytb</code>',\n      '',\n      '<b>/help</b> — Hiện hướng dẫn này',\n    ].join('\\n');\n    return [{ json: { valid: true, route: 'help', chat_id, text } }];\n  }\n\n  // ---- Ad-review commands (no slash needed) ----\n  const looksCut = command === 'cut' || lower.includes('cắt') || lower.includes('cat ');\n  const looksUpload = command === 'upload'\n    || lower.startsWith('đăng') || lower.startsWith('dang')\n    || ((lower.includes('đăng') || lower.includes('dang'))\n        && (lower.includes('ytb') || lower.includes('youtube') || lower.includes('yt')));\n\n  const timeRe = /(\\d{1,2}:\\d{2}:\\d{2}|\\d{1,2}:\\d{2})\\s*(?:->|→|—|–|-|đến|den|tới|toi)\\s*(\\d{1,2}:\\d{2}:\\d{2}|\\d{1,2}:\\d{2})/g;\n  const toSec = (t) => String(t).trim().split(':').reduce((a, v) => a * 60 + Number(v), 0);\n  const spans = [];\n  let tm;\n  while ((tm = timeRe.exec(trimmed)) !== null) {\n    let a = toSec(tm[1]);\n    let b = toSec(tm[2]);\n    if (!Number.isFinite(a) || !Number.isFinite(b)) continue;\n    if (b <= a) b = a + 1; // mốc điểm/0 giây -> cắt tối thiểu 1s\n    spans.push([a, b]);\n  }\n\n  if (looksCut && spans.length > 0) {\n    const batch_id = findBatchId();\n    if (!batch_id) throw new Error('Không xác định được video cần cắt. Hãy reply vào tin \"cần duyệt\" rồi gửi lệnh cắt.');\n    return [{ json: { valid: true, route: 'cut', chat_id, id: batch_id, spans, count: spans.length } }];\n  }\n  if (looksUpload) {\n    const batch_id = findBatchId();\n    if (!batch_id) throw new Error('Không xác định được video cần đăng. Hãy reply vào tin \"cần duyệt\" rồi gửi \"đăng ytb\".');\n    return [{ json: { valid: true, route: 'upload', chat_id, id: batch_id } }];\n  }\n  if (looksCut && spans.length === 0) {\n    throw new Error('Không tìm thấy mốc thời gian. Ví dụ: cắt đoạn 01:29:52 -> 01:30:10');\n  }\n\n  // ---- URL commands (short / long) ----\n  const forceRefreshAll = /(^|\\s)--refresh(\\s|$)/i.test(rest);\n  rest = rest.replace(/(^|\\s)--refresh(\\s|$)/ig, ' ');\n\n  const urlTokens = (rest.match(/!?https?:\\/\\/[^\\s<>\"']+/gi) || []);\n  const urls = urlTokens.map(t => t.replace(/^!+/, ''));\n  if (urlTokens.length === 0) throw new Error('Không tìm thấy link Douyin');\n\n  if (command === 'long') {\n    const videos = [];\n    const errors = [];\n    for (const token of urlTokens) {\n      const forceRefreshOne = token.startsWith('!');\n      const rawUrl = forceRefreshOne ? token.slice(1) : token;\n      try {\n        const item = { douyin_url: validateDouyinUrl(rawUrl) };\n        if (forceRefreshOne) item.force_refresh = true;\n        videos.push(item);\n      } catch (e) { errors.push(e.message); }\n    }\n    if (videos.length === 0) throw new Error('Không có link hợp lệ. ' + errors.join('; '));\n    return [{ json: { valid: true, route: 'long', videos, force_refresh: forceRefreshAll, count: videos.length, chat_id, id: makeId(), skipped: errors } }];\n  }\n\n  const douyin_url = validateDouyinUrl(urls[0]);\n  return [{ json: { valid: true, route: 'short', douyin_url, chat_id, id: makeId() } }];\n\n} catch (error) {\n  return [{ json: { valid: false, route: 'error', error: error.message, chat_id } }];\n}\n"
      },
