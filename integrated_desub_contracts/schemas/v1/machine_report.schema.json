{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.desub.local/v1/machine_report.schema.json",
  "title": "Deterministic clean or dub machine QA report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate", "attempt", "policy", "bindings", "decision",
    "metrics", "implementation", "started_at", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "gate": {"enum": ["clean", "dub"]},
    "attempt": {"$ref": "common.schema.json#/$defs/attemptBinding"},
    "policy": {"$ref": "common.schema.json#/$defs/policyRef"},
    "bindings": {"$ref": "common.schema.json#/$defs/artifactBindings"},
    "decision": {"enum": ["pass", "fail"]},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "decision", "value", "unit", "denominator", "evidence"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "decision": {"enum": ["pass", "fail", "review"]},
          "value": {"type": ["number", "integer", "string", "boolean", "null"]},
          "unit": {"type": "string", "maxLength": 32},
          "denominator": {"type": "integer", "minimum": 0},
          "evidence": {
            "type": "array",
            "items": {"$ref": "common.schema.json#/$defs/objectRef"}
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest", "code_sha256", "metric_decode_sha256"],
      "properties": {
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "code_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "metric_decode_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "started_at": {"$ref": "common.schema.json#/$defs/rfc3339"},
    "finished_at": {"$ref": "common.schema.json#/$defs/rfc3339"}
  },
  "allOf": [
    {
      "if": {"properties": {"gate": {"const": "dub"}}, "required": ["gate"]},
      "then": {
        "properties": {
          "bindings": {"$ref": "common.schema.json#/$defs/releaseBindings"}
        }
      }
    }
  ]
}
