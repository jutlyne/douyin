{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.desub.local/v1/release_index.schema.json",
  "title": "Generation-conditional active integrated release index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt", "release_approval_id", "release_approval",
    "clean_approval_id", "clean_sha256", "source_cue_manifest_sha256",
    "cue_ledger_sha256", "dubbed_sha256", "clean_policy_sha256",
    "dub_policy_sha256", "state_version", "activated_at"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "attempt": {"$ref": "common.schema.json#/$defs/attemptBinding"},
    "release_approval_id": {"$ref": "common.schema.json#/$defs/releaseApprovalId"},
    "release_approval": {"$ref": "common.schema.json#/$defs/objectRef"},
    "clean_approval_id": {"$ref": "common.schema.json#/$defs/cleanApprovalId"},
    "clean_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "source_cue_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "cue_ledger_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "dubbed_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "clean_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "dub_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "state_version": {"type": "integer", "minimum": 1},
    "activated_at": {"$ref": "common.schema.json#/$defs/rfc3339"}
  }
}
