{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.desub.local/v1/cue_ledger.schema.json",
  "title": "Final immutable N-to-N cue selection ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt", "source_cue_manifest", "cue_count", "cues",
    "translation_policy_sha256", "tts_policy_sha256", "vietsub_style_policy_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "attempt": {"$ref": "common.schema.json#/$defs/attemptBinding"},
    "source_cue_manifest": {"$ref": "common.schema.json#/$defs/objectRef"},
    "cue_count": {"type": "integer", "minimum": 1},
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cue_id", "cue_index", "source_cue_record_sha256", "candidate_index",
          "translation_attempt", "translation_candidate_sha256", "translation_text_vi_nfc",
          "translation_preflight_approval",
          "translation_preflight_approval_sha256", "tts_attempt", "tts_pcm_sha256",
          "tts_schedule", "vietsub_event"
        ],
        "properties": {
          "cue_id": {"$ref": "common.schema.json#/$defs/cueId"},
          "cue_index": {"type": "integer", "minimum": 0},
          "source_cue_record_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "candidate_index": {"type": "integer", "minimum": 0, "maximum": 2},
          "translation_attempt": {"$ref": "common.schema.json#/$defs/objectRef"},
          "translation_candidate_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "translation_text_vi_nfc": {"type": "string", "minLength": 1, "maxLength": 2048},
          "translation_preflight_approval": {
            "allOf": [
              {"$ref": "common.schema.json#/$defs/objectRef"},
              {"properties": {"content_type": {"const": "application/json"}}}
            ]
          },
          "translation_preflight_approval_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "tts_attempt": {"$ref": "common.schema.json#/$defs/objectRef"},
          "tts_pcm_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "tts_schedule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speech_anchor_sample", "previous_actual_offset_sample_inclusive",
              "target_actual_onset_sample", "video_sample_count", "placement_sample", "detected_onset_sample",
              "detected_offset_sample_inclusive", "actual_onset_sample",
              "actual_offset_sample_inclusive", "lag_samples", "previous_gap_samples",
              "overlap_samples"
            ],
            "properties": {
              "speech_anchor_sample": {"type": "integer", "minimum": 0},
              "previous_actual_offset_sample_inclusive": {"type": ["integer", "null"], "minimum": 0},
              "target_actual_onset_sample": {"type": "integer", "minimum": 0},
              "video_sample_count": {"type": "integer", "minimum": 1},
              "placement_sample": {"type": "integer", "minimum": 0},
              "detected_onset_sample": {"type": "integer", "minimum": 0},
              "detected_offset_sample_inclusive": {"type": "integer", "minimum": 0},
              "actual_onset_sample": {"type": "integer", "minimum": 0},
              "actual_offset_sample_inclusive": {"type": "integer", "minimum": 0},
              "lag_samples": {"type": "integer", "minimum": 0, "maximum": 26460},
              "previous_gap_samples": {"type": ["integer", "null"], "minimum": 2205},
              "overlap_samples": {"const": 0}
            }
          },
          "vietsub_event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text_vi_nfc", "start_sample", "end_sample_inclusive", "line_count",
              "chosen_font_px", "text_lines_nfc", "line_break_sequence",
              "anchor_x_px", "anchor_y_px", "rendered_alpha_bbox_px",
              "vietsub_alpha_mask", "font_file_sha256", "renderer_binding_sha256",
              "vietsub_style_policy_sha256", "render_event_sha256"
            ],
            "properties": {
              "text_vi_nfc": {"type": "string", "minLength": 1, "maxLength": 2048},
              "start_sample": {"type": "integer", "minimum": 0},
              "end_sample_inclusive": {"type": "integer", "minimum": 0},
              "line_count": {"type": "integer", "minimum": 1, "maximum": 2},
              "chosen_font_px": {"type": "integer", "minimum": 1},
              "text_lines_nfc": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {"type": "string", "minLength": 1, "maxLength": 2048}
              },
              "line_break_sequence": {
                "type": "array",
                "minItems": 0,
                "maxItems": 1,
                "items": {"const": "\\N"}
              },
              "anchor_x_px": {"type": "integer", "minimum": 0},
              "anchor_y_px": {"type": "integer", "minimum": 0},
              "rendered_alpha_bbox_px": {"$ref": "#/$defs/pixelBbox"},
              "vietsub_alpha_mask": {
                "allOf": [
                  {"$ref": "common.schema.json#/$defs/objectRef"},
                  {
                    "properties": {
                      "content_type": {"const": "image/png"}
                    }
                  }
                ]
              },
              "font_file_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
              "renderer_binding_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
              "vietsub_style_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
              "render_event_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
            },
            "oneOf": [
              {
                "properties": {
                  "line_count": {"const": 1},
                  "text_lines_nfc": {"minItems": 1, "maxItems": 1},
                  "line_break_sequence": {"minItems": 0, "maxItems": 0}
                }
              },
              {
                "properties": {
                  "line_count": {"const": 2},
                  "text_lines_nfc": {"minItems": 2, "maxItems": 2},
                  "line_break_sequence": {"minItems": 1, "maxItems": 1}
                }
              }
            ],
            "$comment": "The oneOf binds line_count to the number of text lines and to exactly line_count-1 literal ASS \\N separators. Equality of text_vi_nfc to the semantic join of text_lines_nfc is enforced by the semantic validator because JSON Schema cannot express string concatenation."
          }
        }
      }
    },
    "translation_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "tts_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "vietsub_style_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "created_at": {"$ref": "common.schema.json#/$defs/rfc3339"}
  },
  "$defs": {
    "pixelBbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$comment": "A semantic validator must prove each selected ledger entry binds the same pass translation_preflight_approval used by its selected TTS attempt, with translation_preflight_approval.sha256 == translation_preflight_approval_sha256 and exact attempt/cue/candidate/policy equality."
}
