    {
      "parameters": {
        "jsCode": "\nconst body = $('Webhook Callback').item.json.body || {};\nconst chat_id = body.chat_id;\nconst batch_id = body.batch_id || body.id || '';\nconst sd = $getWorkflowStaticData('global');\nif (chat_id && batch_id) sd['pending_' + chat_id] = batch_id;\n\nconst cands = body.ad_candidates || [];\nconst list = cands.length\n  ? cands.map((c, i) => `${i + 1}. <code>${c.start_hms || ''}</code> → <code>${c.end_hms || ''}</code> — ${c.reason_vi || ''}${c.confidence ? ` (${Math.round(c.confidence * 100)}%)` : ''}`).join('\\n')\n  : '(Gemini không thấy quảng cáo — có thể đăng luôn)';\nconst isCut = body.event === 'long.cut.completed';\nconst dur = body.duration ? `\\n⏱️ Thời lượng: ${Math.round(body.duration)}s` : '';\nconst watch = body.watch_url || body.download_url || '';\nconst preview = watch ? `\n📺 Xem online (tua được, khỏi tải): ${watch}` : '';\nconst head = isCut\n  ? '✂️ <b>Đã cắt xong — kiểm tra lại bản mới</b>'\n  : '🕵️ <b>Video sẵn sàng — cần bạn duyệt quảng cáo</b>';\nconst text = [\n  head,\n  `🆔 <code>${batch_id}</code>${dur}${preview}`,\n  '',\n  '<b>Mốc nghi quảng cáo:</b>',\n  list,\n  '',\n  '↩️ <b>Trả lời (reply) tin này:</b>',\n  '• Cắt: <code>cắt đoạn 01:29:52 -&gt; 01:30:10</code>',\n  '  (nhiều đoạn: mỗi đoạn một dòng)',\n  '• Đăng: <code>đăng ytb</code>',\n].join('\\n');\nreturn [{ json: { chat_id, batch_id, text } }];\n"
      },
