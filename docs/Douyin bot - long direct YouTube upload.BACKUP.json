    {
      "parameters": {
        "jsCode": "const message = $input.first().json.message;\nconst rawText = message?.text || message?.caption || '';\nconst chat_id = message?.chat?.id;\n\nfunction validateDouyinUrl(url) {\n  const cleaned = url.replace(/^!+/, '').replace(/[.,;!?，。；！？)\\]}]+$/g, '');\n  const parsed = cleaned.match(/^https?:\\/\\/([^/:?#]+)(\\/[^?#]*)?(?:[?#].*)?$/i);\n  if (!parsed) throw new Error('URL không đúng định dạng: ' + url);\n\n  const hostname = parsed[1].toLowerCase().replace(/^www\\./, '');\n  const pathname = parsed[2] || '/';\n\n  const validHost =\n    hostname === 'douyin.com' || hostname.endsWith('.douyin.com') ||\n    hostname === 'iesdouyin.com' || hostname.endsWith('.iesdouyin.com');\n  if (!validHost) throw new Error('Link không thuộc Douyin: ' + url);\n\n  const validPath =\n    (hostname === 'v.douyin.com' && /^\\/[A-Za-z0-9_-]+\\/?$/.test(pathname)) ||\n    /^\\/video\\/\\d+\\/?$/.test(pathname) ||\n    /^\\/share\\/video\\/\\d+\\/?$/.test(pathname) ||\n    /^\\/note\\/\\d+\\/?$/.test(pathname);\n  if (!validPath) throw new Error('Link Douyin không đúng định dạng video: ' + url);\n\n  return cleaned;\n}\n\nfunction makeId() {\n  return `telegram-${chat_id}-${message.message_id}-${Date.now()}`;\n}\n\ntry {\n  const trimmed = rawText.trim();\n  let command = '';\n  let rest = trimmed;\n\n  const cmdMatch = trimmed.match(/^\\/([a-zA-Z0-9_]+)(?:@\\w+)?\\s*([\\s\\S]*)$/);\n  if (cmdMatch) {\n    command = cmdMatch[1].toLowerCase();\n    rest = cmdMatch[2] || '';\n  }\n\n  if (command === 'help') {\n    const text = [\n      '🤖 <b>Bot tạo video từ Douyin</b>',\n      '',\n      '<b>/short</b> &lt;link&gt; — Tạo 1 video <b>Short</b> từ 1 link Douyin',\n      'Ví dụ: <code>/short https://v.douyin.com/xxxxx/</code>',\n      '',\n      '<b>/long</b> &lt;link1&gt; [link2 ...] — Tạo video <b>dài</b>; 1 link = 1 tập, nhiều link = ghép nhiều clip',\n      'Ví dụ 1 tập: <code>/long https://v.douyin.com/aaa/</code>',\n      'Ví dụ ghép nhiều tập: <code>/long https://v.douyin.com/aaa/ https://v.douyin.com/bbb/</code>',\n      '',\n      '<b>/long --refresh</b> &lt;link1&gt; [link2 ...] — Bỏ cache và xử lý lại toàn bộ link',\n      'Ví dụ: <code>/long --refresh https://v.douyin.com/aaa/ https://v.douyin.com/bbb/</code>',\n      '',\n      '<b>/long</b> &lt;link1&gt; !&lt;link2&gt; &lt;link3&gt; — Chỉ xử lý lại link có dấu <code>!</code>',\n      'Ví dụ: <code>/long https://v.douyin.com/aaa/ !https://v.douyin.com/bbb/ https://v.douyin.com/ccc/</code>',\n      '',\n      '<b>/help</b> — Hiện hướng dẫn này',\n      '',\n      '📌 <b>Lưu ý</b>',\n      '• Link hợp lệ: <code>v.douyin.com/...</code>, <code>douyin.com/video/...</code>, <code>/share/video/...</code>, <code>/note/...</code>',\n      '• <b>/long</b> nhận từ 1–30 link. Gửi 1 link để tạo 1 video long riêng; gửi nhiều link để ghép thành video dài.',\n      '• Mặc định <b>/long</b> sẽ dùng cache theo từng link đã xử lý thành công trước đó.',\n      '• Dùng <code>--refresh</code> khi muốn chạy lại toàn bộ, hoặc thêm <code>!</code> trước link muốn chạy lại riêng.',\n      '• Gửi link không kèm lệnh → mặc định tạo <b>Short</b>.',\n      '• Bot sẽ nhắn lại khi xong hoặc khi lỗi.',\n    ].join('\\n');\n\n    return [{ json: { valid: true, route: 'help', chat_id, text } }];\n  }\n\n  const forceRefreshAll = /(^|\\s)--refresh(\\s|$)/i.test(rest);\n  rest = rest.replace(/(^|\\s)--refresh(\\s|$)/ig, ' ');\n\n  const urlTokens = (rest.match(/!?https?:\\/\\/[^\\s<>\"']+/gi) || []);\n  const urls = urlTokens.map(t => t.replace(/^!+/, ''));\n\n  if (urlTokens.length === 0) {\n    throw new Error('Không tìm thấy link Douyin');\n  }\n\n  if (command === 'long') {\n    const videos = [];\n    const errors = [];\n\n    for (const token of urlTokens) {\n      const forceRefreshOne = token.startsWith('!');\n      const rawUrl = forceRefreshOne ? token.slice(1) : token;\n\n      try {\n        const item = { douyin_url: validateDouyinUrl(rawUrl) };\n        if (forceRefreshOne) item.force_refresh = true;\n        videos.push(item);\n      } catch (e) {\n        errors.push(e.message);\n      }\n    }\n\n    if (videos.length === 0) {\n      throw new Error('Không có link hợp lệ. ' + errors.join('; '));\n    }\n\n    return [{\n      json: {\n        valid: true,\n        route: 'long',\n        videos,\n        force_refresh: forceRefreshAll,\n        count: videos.length,\n        chat_id,\n        id: makeId(),\n        skipped: errors,\n      }\n    }];\n  }\n\n  const douyin_url = validateDouyinUrl(urls[0]);\n\n  return [{\n    json: {\n      valid: true,\n      route: 'short',\n      douyin_url,\n      chat_id,\n      id: makeId(),\n    }\n  }];\n\n} catch (error) {\n  return [{ json: { valid: false, route: 'error', error: error.message, chat_id } }];\n}\n"
      },
