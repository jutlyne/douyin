{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.desub.local/v1/job_status.schema.json",
  "title": "Integrated DESUB exact-attempt status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "attempt_id",
    "attempt_seq",
    "state",
    "state_version",
    "launch_state",
    "cached",
    "callback_expected",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "job_id": {"$ref": "common.schema.json#/$defs/jobId"},
    "attempt_id": {"$ref": "common.schema.json#/$defs/attemptId"},
    "attempt_seq": {"type": "integer", "minimum": 1},
    "state": {"$ref": "taxonomy.schema.json#/$defs/state"},
    "state_version": {"type": "integer", "minimum": 1},
    "launch_state": {"$ref": "taxonomy.schema.json#/$defs/launchState"},
    "cached": {"type": "boolean"},
    "callback_expected": {"type": "boolean"},
    "status_url": {"type": "string", "format": "uri", "maxLength": 2048},
    "retry_after_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
    "updated_at": {"$ref": "common.schema.json#/$defs/rfc3339"},
    "clean_approval_id": {"$ref": "common.schema.json#/$defs/cleanApprovalId"},
    "release_approval_id": {"$ref": "common.schema.json#/$defs/releaseApprovalId"},
    "clean_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "source_cue_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "cue_ledger_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "message", "retryable", "context"],
      "properties": {
        "code": {"$ref": "taxonomy.schema.json#/$defs/errorCode"},
        "stage": {"$ref": "taxonomy.schema.json#/$defs/errorStage"},
        "message": {"type": "string", "minLength": 1, "maxLength": 240},
        "retryable": {"type": "boolean"},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cue_index": {"type": "integer", "minimum": 0},
            "limit_name": {"type": "string", "maxLength": 64},
            "retry_after_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ready", "download_url", "expires_at", "size_bytes", "sha256"],
      "properties": {
        "kind": {"const": "dubbed"},
        "ready": {"const": true},
        "download_url": {"type": "string", "format": "uri", "maxLength": 4096},
        "expires_at": {"$ref": "common.schema.json#/$defs/rfc3339"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "completed"}}, "required": ["state"]},
      "then": {
        "required": [
          "artifact", "clean_approval_id", "release_approval_id", "clean_sha256",
          "source_cue_manifest_sha256", "cue_ledger_sha256"
        ],
        "not": {"required": ["error"]}
      },
      "else": {"not": {"required": ["artifact"]}}
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "clean_qa_failed", "translation_failed", "tts_failed",
              "scheduling_failed", "subtitle_failed", "dub_qa_failed", "failed",
              "cancelled"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {"required": ["error"]}
    }
  ]
}
