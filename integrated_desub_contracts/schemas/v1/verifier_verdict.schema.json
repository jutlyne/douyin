{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.desub.local/v1/verifier_verdict.schema.json",
  "title": "Authenticated DESUB verifier verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "attempt", "policy", "model", "bindings",
    "decision", "findings", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "role": {"$ref": "taxonomy.schema.json#/$defs/verifierRole"},
    "attempt": {"$ref": "common.schema.json#/$defs/attemptBinding"},
    "policy": {"$ref": "common.schema.json#/$defs/policyRef"},
    "model": {"$ref": "common.schema.json#/$defs/modelIdentity"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256", "clean_sha256", "source_cue_manifest_sha256",
        "source_cue_collection_root", "policy_sha256"
      ],
      "properties": {
        "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "clean_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "source_cue_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "source_cue_collection_root": {"$ref": "common.schema.json#/$defs/sha256"},
        "policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "cue_id": {"$ref": "common.schema.json#/$defs/cueId"},
        "source_cue_record_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "translation_attempt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "candidate_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "cue_ledger_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "dubbed_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "machine_report_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "decision": {"enum": ["pass", "fail"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "evidence_sha256"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "severity": {"enum": ["info", "warning", "error"]},
          "message": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence_sha256": {
            "type": "array",
            "items": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        }
      }
    },
    "created_at": {"$ref": "common.schema.json#/$defs/rfc3339"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "enum": ["translation_semantic_preflight", "translation_style_preflight"]
          }
        },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "bindings": {
            "required": [
              "cue_id", "source_cue_record_sha256",
              "translation_attempt_sha256", "candidate_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "enum": ["translation_semantics", "translation_style", "dub_audio_video", "dub_final_sol"]
          }
        },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "bindings": {
            "required": ["cue_ledger_sha256", "dubbed_sha256", "machine_report_sha256"]
          }
        }
      }
    }
  ]
}
