# =============================================================
# .env.example -- Douyin Shorts pipeline
# Copy thành .env và điền giá trị thực tế của bạn.
# Dòng comment '# required' phía trên một biến nghĩa là biến đó BẮT BUỘC phải
# set, thiếu sẽ raise lỗi rõ ràng. Không viết '# required' trên cùng dòng với
# biến vì nhiều dotenv parser (python-dotenv, docker --env-file, source) sẽ đọc
# phần sau dấu '=' luôn kể cả comment, khiến biến có giá trị rác thay vì rỗng.
# Biến khác là tùy chọn; nếu bỏ trống sẽ dùng default trong code (ghi trong comment).
# =============================================================

# ----- GCP chung -----
# ID project GCP dùng chung cho mọi service (Cloud Run, GCS, Vertex AI)
# required
GCP_PROJECT_ID=
# Region chạy Cloud Run Job/Service (default: asia-southeast1)
RUN_REGION=
# Region gọi Vertex AI (Gemini). flash-lite chỉ có ở global (default: global)
VERTEX_REGION=
# Đường dẫn file service-account JSON khi chạy local (không cần trên Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=
# Cổng HTTP server lắng nghe (Cloud Run tự set) (default: 8080)
PORT=

# ----- Long flow (container_long + long_job_runner) -----
# Tên Cloud Run Job của long-assembler (default: long-assembler)
ASSEMBLER_JOB_NAME=
# Model Gemini dùng riêng cho phát hiện quảng cáo (mặc định theo GEMINI_MODEL)
GEMINI_AD_MODEL=
# Model Gemini dùng chung mặc định (default: gemini-2.5-pro)
GEMINI_MODEL=
# Padding (giây) thêm khi phân tích ranh giới chunk (default: 3)
LONG_ANALYSIS_PADDING_SECONDS=
# Số lần lặp tối đa khi tự động dò quảng cáo (default: 2)
LONG_AUTO_AD_MAX_PASSES=
# Ngưỡng confidence tối thiểu để tự cắt quảng cáo (default: 0.85)
LONG_AUTO_AD_MIN_CONFIDENCE=
# Bật tự động phát hiện và cắt quảng cáo trong video long (default: false)
LONG_AUTO_REMOVE_ADS=
# Độ dài (giây) mỗi chunk khi cắt video long để xử lý (default: 360)
LONG_CHUNK_SECONDS=
# Bật tự tạo đoạn cliffhanger cuối video long
LONG_CLIFFHANGER_ENABLED=
# Độ dài tối đa (giây) đoạn tìm cliffhanger (default: 900)
LONG_CLIFFHANGER_MAX_SECONDS=
# Độ dài tối thiểu (giây) đoạn tìm cliffhanger (default: 600)
LONG_CLIFFHANGER_MIN_SECONDS=
# Độ dài chunk tối đa (giây) (default: 480)
LONG_MAX_CHUNK_SECONDS=
# Độ dài chunk tối thiểu (giây) (default: 240)
LONG_MIN_CHUNK_SECONDS=
# URI GCS video nguồn long đã tải sẵn (bỏ qua tải lại)
LONG_RAW_SOURCE_URI=
# Bật cổng review thủ công trước khi đăng video long (default: false)
LONG_REVIEW_MODE=
# API key gọi vào long-job-runner
LONG_RUNNER_API_KEY=
# Audience OAuth (identity token) khi n8n gọi long-job-runner
LONG_RUNNER_AUDIENCE=
# URL service long-job-runner để n8n gọi trigger batch long
LONG_RUNNER_URL=
# Version cache nguồn video long (đổi để bust cache) (default: v4)
LONG_SOURCE_CACHE_VERSION=
# Giây tối đa lấy từ nguồn video long (0 = lấy hết) (default: 0)
LONG_SOURCE_MAX_SECONDS=
# Giây bắt đầu cắt trong nguồn video long (default: 0)
LONG_SOURCE_START_SECONDS=
# CRF encode video long (chất lượng/độ nén) (default: 18)
LONG_VIDEO_CRF=
# Chiều cao (px) video long output (default: 1080)
LONG_VIDEO_HEIGHT=
# Chiều rộng (px) video long output (default: 1920)
LONG_VIDEO_WIDTH=
# Chế độ tự làm mới hình ảnh giữa các chunk long (default: auto)
LONG_VISUAL_REFRESH=
# URI GCS của manifest batch cần assemble
MANIFEST_URI=
# Prefix GCS lưu output cuối của flow long (default: gs://YOUR_GCP_PROJECT-media-sg/long)
OUTPUT_ROOT=
# Tên Cloud Run Job của long-review (default: long-review)
REVIEW_JOB_NAME=
# Prefix GCS lưu file tạm của flow long (default: gs://YOUR_GCP_PROJECT-scratch-sg/long)
SCRATCH_ROOT=
# Chữ badge (VD: số phần) overlay lên thumbnail
THUMBNAIL_BADGE_TEXT=
# Bỏ qua thumbnail đã có, sinh lại từ đầu
THUMBNAIL_FORCE_REFRESH=
# Bật tự sinh thumbnail bằng Gemini image cho video long (default: false)
THUMBNAIL_GENERATE_ENABLED=
# Tên Cloud Run Job của long-thumbnail-generator (default: long-thumbnail-generator)
THUMBNAIL_GENERATOR_JOB_NAME=
# Chữ tiêu đề mặc định overlay lên thumbnail (default: XUYÊN KHÔNG ĐẠI ĐƯỜNG)
THUMBNAIL_HEADLINE=
# Model Gemini image dùng để sinh thumbnail (default: gemini-2.5-flash-image)
THUMBNAIL_MODEL=
# Số phần (Part) hiển thị trên thumbnail
THUMBNAIL_PART_NUMBER=
# URI GCS ảnh tham chiếu nhân vật để sinh thumbnail
THUMBNAIL_REFERENCE_URI=
# Bắt buộc phải có thumbnail thì mới coi batch là thành công (default: false)
THUMBNAIL_REQUIRED=
# URI GCS ghi kết quả (status) job sinh thumbnail
THUMBNAIL_RESULT_URI=
# URI GCS ghi ảnh thumbnail sinh ra
# required
THUMBNAIL_URI=
# Số worker chạy song song cho một batch long (default: 2)
WORKER_FANOUT=
# Tên Cloud Run Job của long-worker (default: long-worker)
WORKER_JOB_NAME=
# Số lần thử lại tối đa cho mỗi nguồn video long (default: 2)
WORKER_SOURCE_MAX_ATTEMPTS=

# ----- Short flow (container_short + job_runner) -----
# Bắt buộc OCR phụ đề phải thành công, fail cứng nếu không (default: false)
STRICT_SUBTITLE_OCR=
# Căn thời điểm lồng tiếng theo giọng nói gốc (default: false)
ALIGN_DUB_TO_SPEECH=
# ID batch xử lý
BATCH_ID=
# URI GCS của batch spec (danh sách video cần worker xử lý)
BATCH_SPEC_URI=
# Mức giảm/tăng âm lượng nhạc nền (dB) (default: -20)
BGM_GAIN_DB=
# Bật gọi callback về n8n sau khi job xong (default: false)
CALLBACK_ENABLED=
# URL callback n8n nhận kết quả job
CALLBACK_URL=
# Device fingerprint JSON dùng để gọi API CapCut
CAPCUT_DEVICE_JSON=
# Timeout (giây) chờ CapCut TTS render xong (default: 300)
CAPCUT_POLL_TIMEOUT=
# Resource ID giọng đọc CapCut (default: 7102355709945188865)
CAPCUT_RESOURCE_ID=
# Số aweme_id tối đa giữ trong mỗi file state kênh (default: 2000)
CHANNEL_STATE_MAX=
# Prefix GCS lưu trạng thái đã xử lý theo kênh (chống đăng trùng) (default: gs://YOUR_GCP_PROJECT-shorts/state/channels/)
CHANNEL_STATE_PREFIX=
# Index task hiện tại khi chạy Cloud Run Job dạng array task (default: 0)
CLOUD_RUN_TASK_INDEX=
# Timeout (giây) mở trình duyệt để lấy link Douyin (default: 30)
DOUYIN_BROWSER_TIMEOUT_SECONDS=
# Thời gian chờ (ms) trang Douyin load trước khi đọc DOM (default: 15000)
DOUYIN_BROWSER_WAIT_MS=
# Cookie Douyin (tùy chọn) nếu trang share yêu cầu đăng nhập
DOUYIN_COOKIE=
# Số lần thử tải lại video Douyin khi lỗi (default: 3)
DOUYIN_DOWNLOAD_ATTEMPTS=
# Chỉ probe metadata Douyin, không xử lý video (debug)
DOUYIN_PROBE_ONLY=
# URL video Douyin cần xử lý
DOUYIN_URL=
# Tốc độ tối đa khi micro-fit đoạn cuối câu lồng tiếng (default: 1.08)
DUB_END_MICROFIT_MAX_SPEED=
# Tốc độ lồng tiếng tối đa tuyệt đối (hard cap) (default: 1.45)
DUB_HARD_MAX_SPEED=
# Tốc độ lồng tiếng tối đa cho phép (default: 1.35)
DUB_MAX_SPEED=
# Chế độ dựng lồng tiếng (timed/...) (default: timed)
DUB_MODE=
# Khoảng dư (giây) cuối clip cho phần lồng tiếng (default: 1.0)
DUB_TAIL_HEADROOM_SECONDS=
# Khoảng đệm (giây) thêm sau câu lồng tiếng cuối (default: 3.0)
DUB_TAIL_PAD_SECONDS=
# Bật chèn nhạc nền cho video short (default: true)
ENABLE_BGM=
# Bật chèn phụ đề cho video short (default: false)
ENABLE_SUBTITLES=
# Bật OCR đọc phụ đề gốc từ video Douyin (default: false)
ENABLE_SUBTITLE_OCR=
# Voice ID dùng cho Google TTS (default: vi-VN-Wavenet-B)
GOOGLE_TTS_VOICE=
# Prefix GCS lưu output của flow short
OUTPUT_PREFIX=
# Prefix GCS lưu file tạm khi xử lý video (default: gs://YOUR_GCP_PROJECT-scratch-sg/long)
SCRATCH_GS_PREFIX=
# Index nguồn video trong batch (default: 0)
SOURCE_INDEX=
# Tốc độ đọc cho Google TTS (default: 1.0)
SPEAKING_RATE=
# Hệ số tăng tốc video short (default: 1.0)
SPEED=
# Lề dọc (px) đặt phụ đề (default: 690)
SUBTITLE_MARGIN_V=
# FPS lấy mẫu khi OCR phụ đề (default: 4.0)
SUBTITLE_OCR_FPS=
# Provider OCR phụ đề (tesseract/gemini) (default: tesseract)
SUBTITLE_OCR_PROVIDER=
# Prefix GCS ghi output riêng cho subtitle job
SUBTITLE_OUTPUT_PREFIX=
# Chế độ đồng bộ timing phụ đề (gemini/ocr/...) (default: gemini)
SUBTITLE_SYNC_MODE=
# Offset thời gian (giây) áp vào timing phụ đề (default: 0)
SUBTITLE_TIME_OFFSET_SECONDS=
# Độ dài mục tiêu (giây) của video short (default: 40)
TARGET_SECONDS=
# Provider TTS dự phòng khi provider chính lỗi (default: google)
TTS_FALLBACK_PROVIDER=
# Provider TTS chính (capcut/google) (default: capcut)
TTS_PROVIDER=
# Voice ID dùng cho TTS chính (CapCut) (default: BV074_streaming)
TTS_VOICE=

# ----- Desub (experiments/desub + integrated_desub_* + desub_job_runner) -----
# Thư mục chứa model EasyOCR đã tải sẵn (tránh tải lại lúc runtime) (default: /models/easyocr)
EASYOCR_MODEL_DIR=
# Vertex region dùng khi gọi Gemini QA cho desub (default: asia-southeast1)
VERTEX_QA_LOCATION=
# Model Gemini dùng để QA kết quả desub/visub (default: gemini-2.5-flash)
VERTEX_QA_MODEL=
# FPS lấy mẫu video khi QA bằng Gemini (default: 8)
VERTEX_QA_VIDEO_FPS=
# Thời gian (giây) coi một job đang chạy là còn sống (hết hạn thì coi là treo) (default: 14400)
RUNNING_STATUS_TTL_SECONDS=
# URI GCS video base cho chunked desub pipeline
CHUNKED_BASE_URI=
# Độ dài (giây) phần lõi mỗi chunk trong chunked desub (default: 30)
CHUNKED_CORE_SECONDS=
# URI GCS cues cho chunked desub pipeline
CHUNKED_CUES_URI=
# URI GCS cues đã có sẵn (resume) cho chunked desub
CHUNKED_EXISTING_CUES_URI=
# URI GCS mask cho chunked desub pipeline
CHUNKED_MASK_URI=
# URI GCS output cho chunked desub pipeline
CHUNKED_OUTPUT_URI=
# Độ dài (giây) overlap giữa 2 chunk liên tiếp (default: 2)
CHUNKED_OVERLAP_SECONDS=
# Index lần thử lại cho chunked desub (debug)
CHUNKED_RETRY_INDEX=
# URI GCS video nguồn cho chunked desub pipeline
CHUNKED_SOURCE_URI=
# Prefix GCS lưu file tạm cho chunked desub pipeline
CHUNKED_WORK_PREFIX=
# URI GCS file cues (visub) đầu vào cho cover-visub lab
COVER_CUES_URI=
# Model Gemini dùng sinh cue cho cover-visub (mặc định theo GEMINI_MODEL)
COVER_CUE_MODEL=
# Vertex region cho cover-visub (mặc định theo VERTEX_REGION)
COVER_CUE_REGION=
# URL Douyin nguồn cho cover-visub lab
COVER_DOUYIN_URL=
# URI GCS mask vùng cần xoá cho cover-visub lab
COVER_MASK_URI=
# URI GCS video output của cover-visub lab
COVER_OUTPUT_URI=
# Version pipeline cover-visub (đổi để bust cache kết quả) (default: v9)
COVER_PIPELINE_VERSION=
# Prefix GCS gốc lưu kết quả cover-visub lab (default: gs://YOUR_GCP_PROJECT-media-sg/desub/cover-visub)
COVER_RESULT_ROOT=
# URI GCS video nguồn cho cover-visub lab
COVER_SOURCE_URI=
# Ngân sách thời gian (giây) tối đa cho detector desub (default: 600)
DESUB_DETECTOR_BUDGET_SECONDS=
# Ngưỡng low_text của EasyOCR khi phát hiện chữ (default: 0.25)
DESUB_EASYOCR_LOW_TEXT=
# Ngưỡng text_threshold của EasyOCR khi phát hiện chữ (default: 0.25)
DESUB_EASYOCR_TEXT_THRESHOLD=
# Đơn giá GPU L4 (USD/giờ) dùng để ước tính chi phí desub (default: 0.70)
DESUB_L4_USD_PER_HOUR=
# Hệ số blend theo thời gian khi inpaint bằng LaMA
DESUB_LAMA_TEMPORAL_BLEND=
# Model inpainting dùng để xoá sub cứng (lama/...) (default: lama)
DESUB_MODEL=
# CRF encode video output của desub (default: 0)
DESUB_OUTPUT_CRF=
# Độ dài (giây) đoạn zoom khi tạo clip QA desub (default: 2)
DESUB_QA_ZOOM_SECONDS=
# Bắt buộc phải có CUDA mới cho chạy desub
DESUB_REQUIRE_CUDA=
# ID lần chạy desub lab (đặt tên thư mục kết quả)
DESUB_RUN_ID=
# Số lần xuất hiện tối thiểu để tính là static mask (default: 2)
DESUB_STATIC_MASK_MIN_HITS=
# Tỉ lệ xuất hiện tối thiểu để tính là static mask
DESUB_STATIC_MASK_MIN_HIT_RATIO=
# Tỉ lệ tối thiểu để fallback sang stroke mask
DESUB_STROKE_FALLBACK_MIN_RATIO=
# Bật phát hiện mask theo viền chữ (stroke) cho desub
DESUB_STROKE_MASK_ENABLED=
# Diện tích lõi tối thiểu (px) để nhận là stroke hợp lệ (default: 4)
DESUB_STROKE_MIN_CORE_AREA_PX=
# Bắt buộc viền chữ phải chạm vùng tối mới nhận stroke
DESUB_STROKE_REQUIRE_DARK_TOUCH=
# URI GCS cues dùng để burn phụ đề visub sau khi desub
DESUB_VISUB_CUES_URI=
# Tên font dùng render phụ đề visub (default: DejaVu Sans)
DESUB_VISUB_FONT=
# Tỉ lệ cỡ chữ phụ đề visub so với chiều cao video (default: 0.040)
DESUB_VISUB_FONT_SIZE_RATIO=
# Timeout (giây) gọi Gemini khi dịch/sinh cues visub (default: 900)
DESUB_VISUB_GEMINI_TIMEOUT_SECONDS=
# CRF encode video output sau khi burn phụ đề visub (default: 18)
DESUB_VISUB_OUTPUT_CRF=
# Số ký tự tối đa mỗi dòng phụ đề visub trước khi wrap (default: 20)
DESUB_VISUB_WRAP_CHARS=
# Toạ độ mask logo/watermark cần xoá cùng lúc với sub
DESUB_WATERMARK_MASKS=
# Prefix GCS lưu kết quả của một attempt trong integrated desub runtime
# required
INTEGRATED_ATTEMPT_PREFIX=
# URI GCS video đã làm sạch base (resume) cho integrated desub
INTEGRATED_CLEAN_BASE_URI=
# Padding (giây) quanh mỗi cue khi làm sạch integrated desub (default: 0.18)
INTEGRATED_CLEAN_CUE_PAD_SECONDS=
# Toạ độ vùng cần làm sạch (x1,y1,x2,y2) cho integrated desub (default: 115,870,605,1015)
INTEGRATED_CLEAN_RECT=
# URI GCS file cues bắt buộc cho integrated desub runtime
# required
INTEGRATED_CUES_URI=
# Generation number kỳ vọng của object clean-base (kiểm tra tính idempotent)
INTEGRATED_EXPECTED_CLEAN_BASE_GENERATION=
# SHA256 kỳ vọng của object clean-base (kiểm tra tính idempotent)
INTEGRATED_EXPECTED_CLEAN_BASE_SHA256=
# Số lượng cue kỳ vọng (validation) (default: 77)
INTEGRATED_EXPECTED_CUES=
# Generation number kỳ vọng của object cues
INTEGRATED_EXPECTED_CUES_GENERATION=
# SHA256 kỳ vọng của object cues
INTEGRATED_EXPECTED_CUES_SHA256=
# Generation number kỳ vọng khi resume từ clean video
INTEGRATED_EXPECTED_RESUME_CLEAN_GENERATION=
# SHA256 kỳ vọng khi resume từ clean video
INTEGRATED_EXPECTED_RESUME_CLEAN_SHA256=
# Generation number kỳ vọng của video nguồn
INTEGRATED_EXPECTED_SOURCE_GENERATION=
# SHA256 kỳ vọng của video nguồn
INTEGRATED_EXPECTED_SOURCE_SHA256=
# Prefix version CUDA kỳ vọng của torch (kiểm tra môi trường GPU) (default: 12.6)
INTEGRATED_EXPECTED_TORCH_CUDA_PREFIX=
# FPS lấy mẫu khi QA phần dư sau khi xoá sub (default: 8)
INTEGRATED_RESIDUAL_QA_FPS=
# URI GCS video clean để resume integrated desub
INTEGRATED_RESUME_CLEAN_URI=
# URI GCS video nguồn bắt buộc cho integrated desub runtime
# required
INTEGRATED_SOURCE_URI=
# Độ rộng viền chữ phụ đề (visub) trong integrated desub (default: 2.5)
INTEGRATED_VISUB_BORDER_WIDTH=
# Vị trí tâm theo trục Y (tỉ lệ 0-1) của phụ đề visub (default: 0.735)
INTEGRATED_VISUB_CENTER_Y=
# Đường dẫn file font dùng để render phụ đề visub (default: /app/fonts/DejaVuSans-Bold.ttf)
INTEGRATED_VISUB_FONT_FILE=
# Khoảng cách giữa các dòng phụ đề visub (px) (default: 6)
INTEGRATED_VISUB_LINE_SPACING=
# Lề an toàn (px) tránh chữ phụ đề bị cắt viền (default: 24)
INTEGRATED_VISUB_SAFE_MARGIN_PIXELS=
# Chế độ chạy pipeline (full/...) (default: full)
MODE=
# Prefix GCS gốc lưu kết quả desub lab (mặc định theo DEFAULT_RESULT_ROOT trong code)
RESULT_PREFIX=
# ID lần chạy (dùng để đặt tên thư mục kết quả)
RUN_ID=
# URI GCS video base bắt buộc cho second-pass LaMA cleanup
# required
SECOND_PASS_BASE_URI=
# URI GCS video đã làm sạch (tùy chọn, resume) cho second-pass
SECOND_PASS_CLEAN_URI=
# URI GCS cues bắt buộc cho second-pass LaMA cleanup
# required
SECOND_PASS_CUES_URI=
# Padding (giây) quanh mỗi cue khi chạy second-pass LaMA (default: 0.12)
SECOND_PASS_CUE_PAD_SECONDS=
# Toạ độ vùng cố định (x1,y1,x2,y2) cần làm sạch ở second-pass
SECOND_PASS_FIXED_RECT=
# URI GCS mask bắt buộc cho second-pass LaMA cleanup
# required
SECOND_PASS_MASK_URI=
# URI GCS output bắt buộc của second-pass LaMA cleanup
# required
SECOND_PASS_OUTPUT_URI=
# URI GCS ghi báo cáo kết quả second-pass
SECOND_PASS_REPORT_URI=
# Danh sách index cue cần xử lý trong second-pass (bỏ trống = tất cả)
SECOND_PASS_TARGET_CUE_INDEXES=
# Mức giảm/tăng âm lượng nhạc nền (dB) khi dựng visub (default: -20)
VISUB_BGM_GAIN_DB=
# Cách lấp vùng che phụ đề gốc (extend_text/...) (default: extend_text)
VISUB_COVER_FILL=
# Preset ffmpeg encode khi che phụ đề gốc (default: veryfast)
VISUB_COVER_PRESET=
# Chế độ tính rect che phụ đề (per_event/...) (default: per_event)
VISUB_COVER_RECT_MODE=
# Kiểu che phụ đề gốc (blur/box/...) (default: blur)
VISUB_COVER_STYLE=
# Cách xử lý đoạn không khớp cue nào khi che phụ đề (cover/...) (default: cover)
VISUB_COVER_UNMATCHED=
# URI GCS ghi kết quả align timing TTS
VISUB_TTS_ALIGNMENT_OUTPUT_URI=
# Model Gemini dùng để align timing TTS với phụ đề (default: gemini-2.5-flash)
VISUB_TTS_ALIGN_MODEL=
# Vertex region cho việc align timing TTS (default: us-central1)
VISUB_TTS_ALIGN_REGION=
# URI GCS ghi báo cáo baseline timing TTS
VISUB_TTS_BASELINE_REPORT_URI=
# Device fingerprint JSON cho TTS trong visub
VISUB_TTS_DEVICE_JSON=
# Provider TTS dự phòng cho visub (default: google)
VISUB_TTS_FALLBACK=
# Khoảng nghỉ cố định (giây) giữa các câu TTS visub (default: 0.05)
VISUB_TTS_FIXED_GAP_SECONDS=
# Độ trễ tối đa (giây) cho phép giữa TTS và phụ đề (default: 0.6)
VISUB_TTS_MAX_LAG_SECONDS=
# Timeout (giây) chờ TTS render xong cho visub (default: 300)
VISUB_TTS_POLL_TIMEOUT=
# Tốc độ đọc TTS cho visub
VISUB_TTS_RATE=
# Resource ID giọng đọc TTS cho visub (default: 7102355803792740865)
VISUB_TTS_RESOURCE_ID=
# Chính sách xử lý slot ngắn khi TTS visub (fixed_rate_narration/...) (default: fixed_rate_narration)
VISUB_TTS_SHORT_SLOT_POLICY=
# URI GCS ghi timing giọng nói dùng cho TTS visub
VISUB_TTS_SPEECH_TIMINGS_URI=
# Chế độ tính timing phụ đề cho visub (cluster/...) (default: cluster)
VISUB_TTS_SUBTITLE_TIMING=
# URI GCS chứa nội dung chữ ghi đè cho TTS visub
VISUB_TTS_TEXT_OVERRIDES_URI=
# Voice ID TTS dùng cho visub (default: BV075_streaming)
VISUB_TTS_VOICE=
# URI GCS ghi baseline hình ảnh dùng so sánh QA visub
VISUB_VISUAL_BASELINE_OUTPUT_URI=
# Thư mục local tạm để xử lý file trung gian
WORK_DIR=

# ----- Telegram / n8n -----
# Token xác thực callback gọi ngược vào n8n
CALLBACK_TOKEN=
# Chat ID Telegram nhận thông báo/callback
CHAT_ID=
# Danh sách khoảng thời gian (JSON) cần cắt bỏ trong video (default: [])
CUT_SPANS=
# Chạy thử flow n8n không thực thi hành động thật
DRY_RUN=
# Bucket GCS lưu state của flow n8n (chống chạy trùng)
FLOW_STATE_BUCKET=
# Prefix path trong bucket lưu state flow n8n (default: telegram-series-state)
FLOW_STATE_PREFIX=
# Base URL public của n8n (dùng cho webhook)
PUBLIC_BASE_URL=
# Chuỗi trong response body báo n8n cần restart (watchdog) (default: Database is not ready)
RESTART_ON_BODY=
# HTTP status báo n8n cần restart (watchdog) (default: 503)
RESTART_ON_STATUS=
# Chat ID Telegram dùng cho flow tự động chạy tiếp series
SERIES_AUTO_CHAT_ID=
# Phần cuối cùng flow tự động sẽ chạy tới
SERIES_AUTO_UNTIL_PART=
# Ngày gốc (YYYY-MM-DD) để tính lịch đăng các phần tiếp theo
SERIES_SCHEDULE_BASE_DATE=
# Số phần gốc tương ứng với SERIES_SCHEDULE_BASE_DATE
SERIES_SCHEDULE_BASE_PART=
# Danh sách giờ trong ngày (HH:MM, phân tách bởi dấu phẩy) để lên lịch đăng
SERIES_SCHEDULE_TIMES=
# Offset timezone (VD +07:00) áp dụng khi tính lịch đăng (default: +07:00)
SERIES_SCHEDULE_TIMEZONE_OFFSET=
# Token bot Telegram dùng để gửi/nhận message
# required
TELEGRAM_BOT_TOKEN=
# Secret kiểm tra webhook Telegram gọi đúng nguồn
TELEGRAM_WEBHOOK_SECRET=

# ----- YouTube upload -----
# URI GCS file final-long.json (metadata video long)
# required
METADATA_URI=
# Số phần (Part) của video trong series (default: 1)
PART_NUMBER=
# URI GCS ảnh tham chiếu đưa vào job sinh thumbnail
# required
REFERENCE_IMAGE_URI=
# URI GCS ghi kết quả upload YouTube
UPLOAD_RESULT_URI=
# URI GCS video cần upload lên YouTube
# required
VIDEO_URI=
# OAuth access token YouTube (thường không set, tự refresh)
YOUTUBE_ACCESS_TOKEN=
# Category ID video YouTube (default: 24)
YOUTUBE_CATEGORY_ID=
# Timeout (giây) cho mỗi chunk upload YouTube (default: 900)
YOUTUBE_CHUNK_TIMEOUT_SECONDS=
# OAuth client id của app YouTube Data API
# required
YOUTUBE_CLIENT_ID=
# OAuth client secret của app YouTube Data API
# required
YOUTUBE_CLIENT_SECRET=
# Mô tả video YouTube
YOUTUBE_DESCRIPTION=
# Đánh dấu video YouTube là nội dung cho trẻ em
YOUTUBE_MADE_FOR_KIDS=
# Gửi thông báo cho subscriber khi đăng video
YOUTUBE_NOTIFY_SUBSCRIBERS=
# Trạng thái riêng tư video YouTube (private/unlisted/public) (default: private)
YOUTUBE_PRIVACY_STATUS=
# Thời điểm lên lịch publish video YouTube (RFC3339)
YOUTUBE_PUBLISH_AT=
# OAuth refresh token của account YouTube dùng để upload
# required
YOUTUBE_REFRESH_TOKEN=
# Timeout (giây) cho các request khác tới YouTube API (default: 120)
YOUTUBE_REQUEST_TIMEOUT_SECONDS=
# Tags video YouTube (phân tách bởi dấu phẩy)
YOUTUBE_TAGS=
# URI GCS ảnh thumbnail để set cho video YouTube
YOUTUBE_THUMBNAIL_URI=
# Tiêu đề video YouTube
YOUTUBE_TITLE=
# Timeout (giây) khi refresh OAuth token YouTube (default: 30)
YOUTUBE_TOKEN_TIMEOUT_SECONDS=
# Tên Cloud Run Job của long-youtube-uploader (default: long-youtube-uploader)
YOUTUBE_UPLOADER_JOB_NAME=
# Kích thước (byte) mỗi chunk khi upload resumable lên YouTube
YOUTUBE_UPLOAD_CHUNK_BYTES=
# Bật upload video lên YouTube sau khi xử lý xong (default: false)
YOUTUBE_UPLOAD_ENABLED=
# Số lần thử lại tối đa khi upload YouTube lỗi (default: 8)
YOUTUBE_UPLOAD_MAX_RETRIES=

# ----- Dùng chung nhiều flow (HTTP job-runner service) -----
# API key để xác thực request gọi vào job runner
API_KEY=
# Secret ký HMAC cho link tải xuống tạm thời
DOWNLOAD_SECRET=
# Thời gian sống (giây) của link tải xuống đã ký (default: 43200)
DOWNLOAD_TTL_SECONDS=
# URL tải video (dùng trong flow legacy)
DOWNLOAD_URL=
# Tên Cloud Run Job sẽ được trigger (default: cover-visub-lab)
JOB_NAME=
# URI GCS ghi video output
OUTPUT_URI=
# Khoảng thời gian (giây) giữa các lần poll trạng thái job (default: 10)
POLL_SECONDS=
# Timeout (giây) cho HTTP request ra ngoài (default: 15)
REQUEST_TIMEOUT_SECONDS=
# URI GCS của request.json cho batch long
REQUEST_URI=
# Base URL public của service (dùng để build link tải xuống)
SERVICE_BASE_URL=
# URI GCS video nguồn đầu vào cho job
SOURCE_URI=
# Timeout (giây) chờ Cloud Run Job hoàn thành (default: 43200)
WAIT_TIMEOUT_SECONDS=
# Prefix GCS lưu file tạm của batch
WORK_PREFIX=
