{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.desub.local/v1/job_state_record.schema.json",
  "title": "Immutable-versioned internal DESUB attempt state record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt", "request_body_sha256", "content_fingerprint",
    "state", "state_version", "launch_state", "launch_token_digest",
    "compact_retries_used", "clean_repair_attempts_used",
    "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "attempt": {"$ref": "common.schema.json#/$defs/attemptBinding"},
    "request_body_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "content_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
    "state": {"$ref": "job_status.schema.json#/properties/state"},
    "state_version": {"type": "integer", "minimum": 1},
    "launch_state": {"$ref": "job_status.schema.json#/properties/launch_state"},
    "launch_token_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "cloud_run_operation": {"type": ["string", "null"], "maxLength": 512},
    "cloud_run_execution": {"type": ["string", "null"], "maxLength": 512},
    "compact_retries_used": {"type": "integer", "minimum": 0, "maximum": 2},
    "clean_repair_attempts_used": {"type": "integer", "minimum": 0, "maximum": 1},
    "clean_approval_id": {"$ref": "common.schema.json#/$defs/cleanApprovalId"},
    "release_approval_id": {"$ref": "common.schema.json#/$defs/releaseApprovalId"},
    "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "clean_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "source_cue_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "cue_ledger_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "dubbed_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "terminal_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
    "created_at": {"$ref": "common.schema.json#/$defs/rfc3339"},
    "updated_at": {"$ref": "common.schema.json#/$defs/rfc3339"}
  }
}
